{
  "id": "example-scheduler",
  "name": "Example Scheduler",
  "version": "0.2.0",
  "manifest_version": "2",
  "plugin_protocol_version": "1",
  "runtime": "go",
  "entry": "bin/example-scheduler",
  "platforms": ["windows-x64", "linux-x64", "macos-arm64"],
  "license": "MIT",
  "description": "Go example plugin demonstrating scheduler.create.",
  "author": "raylea",
  "capabilities": [
    "event.subscribe",
    "scheduler.create"
  ],
  "commands": [
    {
      "name": "schedule_daily",
      "description": "Create a daily scheduler.trigger task.",
      "usage": "/schedule_daily"
    }
  ]
}
