{
  "id": "example-plugin-list",
  "name": "Example Plugin List",
  "version": "0.2.0",
  "manifest_version": "3",
  "license": "MIT",
  "commands": [
    {
      "id": "plugins-demo",
      "name": "plugins_demo",
      "description": "List loaded plugin names through plugin.list.",
      "usage": "/plugins_demo",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "plugins_demo"
        ]
      }
    }
  ],
  "min_core_version": "0.4.0",
  "metadata": {
    "description": "Go example plugin demonstrating plugin.list.",
    "author": "raylea"
  },
  "events": [
    "message.group",
    "message.private"
  ],
  "permissions": {
    "plugin.list": true,
    "message.send": true
  }
}
