{
  "id": "example-plugin-list",
  "name": "Example Plugin List",
  "version": "0.2.0",
  "manifest_version": "2",
  "plugin_protocol_version": "1",
  "runtime": "go",
  "entry": "bin/example-plugin-list",
  "platforms": ["windows-x64", "linux-x64", "macos-arm64"],
  "license": "MIT",
  "description": "Go example plugin demonstrating plugin.list.",
  "author": "raylea",
  "role": "example",
  "capabilities": [
    "event.subscribe",
    "plugin.list",
    "message.send"
  ],
  "commands": [
    {
      "name": "plugins_demo",
      "description": "List loaded plugin names through plugin.list.",
      "usage": "/plugins_demo"
    }
  ]
}
