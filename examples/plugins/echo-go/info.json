{
  "id": "echo-go",
  "name": "Echo",
  "version": "0.2.0",
  "manifest_version": "2",
  "plugin_protocol_version": "1",
  "runtime": "go",
  "entry": "bin/echo-go",
  "platforms": ["windows-x64", "linux-x64", "macos-arm64"],
  "license": "MIT",
  "description": "Echo plugin demonstrating command parsing and message segments",
  "author": "raylea",
  "capabilities": [
    "event.subscribe",
    "message.send"
  ],
  "commands": [
    {
      "name": "echo",
      "aliases": [
        "repeat"
      ],
      "description": "回复收到的消息内容",
      "usage": "/echo <内容>",
      "permission": "everyone"
    }
  ]
}
