{
  "id": "echo-go",
  "name": "Echo",
  "version": "0.2.0",
  "manifest_version": "3",
  "license": "MIT",
  "commands": [
    {
      "id": "echo",
      "name": "echo",
      "description": "回复收到的消息内容",
      "usage": "/echo <内容>",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "echo",
          "repeat"
        ]
      }
    }
  ],
  "min_core_version": "0.4.0",
  "metadata": {
    "description": "Echo plugin demonstrating command parsing and message segments",
    "author": "raylea"
  },
  "events": [
    "message.group",
    "message.private"
  ],
  "permissions": {
    "message.send": true
  }
}
