{
  "id": "example-config-panel",
  "name": "Example Config Panel",
  "version": "0.2.0",
  "manifest_version": "2",
  "plugin_protocol_version": "1",
  "runtime": "go",
  "entry": "bin/example-config-panel",
  "platforms": ["windows-x64", "linux-x64", "macos-arm64"],
  "license": "MIT",
  "description": "Go and Vue example plugin demonstrating config.read and config.write.",
  "author": "raylea",
  "role": "example",
  "management_ui": {
    "pages": [
      {
        "id": "config",
        "label": "配置页面",
        "entry": "ui/index.html"
      }
    ]
  },
  "capabilities": [
    "event.subscribe",
    "config.read",
    "config.write"
  ],
  "default_config": {
    "default_city": "北京",
    "unit": "celsius"
  },
  "commands": [
    {
      "name": "config_panel",
      "description": "Read and update plugin-local config values.",
      "usage": "/config_panel [city]"
    }
  ]
}
