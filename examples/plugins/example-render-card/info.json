{
  "id": "example-render-card",
  "name": "Example Render Card",
  "version": "0.2.0",
  "manifest_version": "3",
  "license": "MIT",
  "commands": [
    {
      "id": "render-card",
      "name": "render_card",
      "description": "Render a simple help card image.",
      "usage": "/render_card",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "render_card"
        ]
      }
    }
  ],
  "min_core_version": "0.4.0",
  "metadata": {
    "description": "Go example plugin demonstrating render.image.",
    "author": "raylea"
  },
  "events": [
    "message.group",
    "message.private"
  ],
  "permissions": {
    "message.send": true,
    "render.image": true
  }
}
