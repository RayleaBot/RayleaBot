{
  "id": "example-render-card",
  "name": "Example Render Card",
  "version": "0.2.0",
  "manifest_version": "2",
  "plugin_protocol_version": "1",
  "runtime": "go",
  "entry": "bin/example-render-card",
  "platforms": ["windows-x64", "linux-x64", "macos-arm64"],
  "license": "MIT",
  "description": "Go example plugin demonstrating render.image.",
  "author": "raylea",
  "capabilities": [
    "event.subscribe",
    "message.send",
    "render.image"
  ],
  "render_templates": [
    {
      "path": "templates/card"
    }
  ],
  "commands": [
    {
      "name": "render_card",
      "description": "Render a simple help card image.",
      "usage": "/render_card"
    }
  ]
}
