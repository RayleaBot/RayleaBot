{
  "id": "example-webhook",
  "name": "Example Webhook",
  "version": "0.2.0",
  "manifest_version": "3",
  "license": "MIT",
  "commands": [],
  "min_core_version": "0.4.0",
  "metadata": {
    "description": "Go example plugin demonstrating statically declared webhooks and gated raw payload delivery.",
    "author": "raylea"
  },
  "events": [
    "webhook.received"
  ],
  "permissions": {
    "event.raw_payload": true
  },
  "webhooks": [
    {
      "id": "github",
      "route": "github",
      "auth_strategy": "hmac_sha256",
      "header": "X-Hub-Signature-256",
      "secret_ref": "webhook.github.secret",
      "signature_prefix": "sha256=",
      "replay_protection": {
        "timestamp_header": "X-Webhook-Timestamp",
        "event_id_header": "X-Webhook-Event-ID",
        "tolerance_seconds": 300,
        "enforce": true
      }
    }
  ]
}
