{
  "id": "example-webhook",
  "name": "Example Webhook",
  "version": "0.2.0",
  "manifest_version": "2",
  "plugin_protocol_version": "1",
  "runtime": "go",
  "entry": "bin/example-webhook",
  "platforms": ["windows-x64", "linux-x64", "macos-arm64"],
  "license": "MIT",
  "description": "Go example plugin demonstrating event.expose_webhook and gated raw payload delivery.",
  "author": "raylea",
  "role": "example",
  "capabilities": [
    "event.subscribe",
    "event.expose_webhook",
    "event.raw_payload",
    "logger.write"
  ],
  "commands": [
    {
      "name": "webhook_register",
      "description": "Register the example GitHub webhook route.",
      "usage": "/webhook_register"
    }
  ],
  "capability_parameters": {
    "webhooks": [
      {
        "route": "github",
        "auth_strategy": "hmac_sha256",
        "header": "X-Hub-Signature-256",
        "secret_ref": "webhook.github.secret"
      }
    ]
  }
}
