<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 @@WIDTH@@ 187" width="100%" role="img" aria-label="Weekly commit heatmap for @@REPO@@">
  <style>
    .bg { fill: #0d1117; }
    .axis-text { fill: #8b949e; font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, monospace; font-size: 10px; }
    .title { fill: #c9d1d9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 600; }
    .cell { width: 12px; height: 12px; rx: 2; ry: 2; }
    .cell:hover { stroke: #c9d1d9; stroke-width: 1.5; }
    @media (prefers-color-scheme: light) {
      .bg { fill: #ffffff; }
      .axis-text { fill: #57606a; }
      .title { fill: #24292f; }
      .cell:hover { stroke: #24292f; }
    }
  </style>
  <rect class="bg" width="@@WIDTH@@" height="187" rx="8"/>
  <text x="40" y="24" class="title">Weekly commit heatmap</text>
