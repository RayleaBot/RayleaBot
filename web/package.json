{
  "name": "rayleabot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "generate:openapi-types": "openapi-typescript ../contracts/web-api.openapi.yaml -o src/types/generated.ts",
    "generate:ws-types": "node scripts/generate-websocket-types.mjs",
    "generate:types": "corepack pnpm run generate:openapi-types && corepack pnpm run generate:ws-types"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@tanstack/vue-virtual": "3.13.24",
    "ant-design-vue": "4.2.6",
    "motion": "12.42.2",
    "pinia": "3.0.4",
    "vue": "3.5.39",
    "vue-i18n": "11.4.6",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.6",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "sass": "1.101.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7",
    "ws": "8.21.0",
    "yaml": "2.9.0"
  }
}
