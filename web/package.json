{
  "name": "rayleabot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node ../scripts/run-vitest.mjs run",
    "test:coverage": "node ../scripts/run-vitest.mjs run --coverage",
    "test:e2e": "playwright test",
    "generate:openapi-types": "openapi-typescript ../contracts/web-api.openapi.yaml -o src/types/generated.ts",
    "generate:ws-types": "node scripts/generate-websocket-types.mjs",
    "generate:types": "corepack pnpm run generate:openapi-types && corepack pnpm run generate:ws-types"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@tanstack/vue-virtual": "3.13.35",
    "ant-design-vue": "4.2.6",
    "motion": "13.1.0",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "sass": "1.102.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.10",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  }
}
