{
  "name": "rayleabot-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "check:indent": "node ../scripts/check-web-indentation.mjs",
    "typecheck": "vue-tsc --build",
    "build": "vue-tsc --build && vite build",
    "test": "node ../scripts/run-vitest.mjs run",
    "test:coverage": "node ../scripts/run-vitest.mjs run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:production": "pnpm run build && playwright test --config playwright.production.config.ts",
    "generate:openapi-types": "openapi-typescript ../contracts/web-api.openapi.yaml -o src/types/generated.ts",
    "generate:ws-types": "node scripts/generate-websocket-types.mjs",
    "generate:types": "corepack pnpm run generate:openapi-types && corepack pnpm run generate:ws-types"
  },
  "dependencies": {
    "@lucide/vue": "1.41.0",
    "@tanstack/vue-virtual": "3.13.35",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion-v": "2.4.2",
    "pinia": "4.0.3",
    "qrcode-generator": "2.0.4",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "sass": "1.102.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.10",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  }
}
