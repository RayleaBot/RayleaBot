{
  "name": "@rayleabot/launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RayleaBot Wails desktop launcher",
  "author": "RayleaBot",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/dev.mjs",
    "generate:wails": "node scripts/run-go.mjs generate:wails",
    "generate:types": "python ../scripts/generate-launcher-api.py && openapi-typescript api-subset.generated.json -o src/shared/web-api.generated.ts",
    "test": "node ../scripts/run-vitest.mjs run && node scripts/run-go.mjs test:platform ./...",
    "test:coverage": "node ../scripts/run-vitest.mjs run --coverage && node scripts/run-go.mjs test:platform -cover ./...",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && node scripts/run-go.mjs vet:platform ./...",
    "build:app": "node scripts/build-app.mjs",
    "build": "node scripts/clean.mjs && node scripts/build-package.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.6",
    "@fluentui/react-icons": "2.0.337",
    "@fluentui/react-message-bar": "9.7.5",
    "@fluentui/react-motion": "9.16.2",
    "@wailsio/runtime": "3.0.0-beta.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
