{
  "name": "@rayleabot/launcher",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "RayleaBot Wails desktop launcher",
  "author": "RayleaBot",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "26.10.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/dev.mjs",
    "generate:wails": "node scripts/run-go.mjs generate:wails",
    "test": "node ../scripts/run-vitest.mjs run && node scripts/run-go.mjs test:platform ./...",
    "test:coverage": "node ../scripts/run-vitest.mjs run --coverage && node scripts/run-go.mjs test:platform -cover ./...",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc -p tsconfig.renderer.json --noEmit && node scripts/run-go.mjs vet:platform ./...",
    "build:app": "node scripts/build-app.mjs",
    "build": "node scripts/clean.mjs && node scripts/build-package.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.41.0",
    "@wailsio/runtime": "3.0.0-beta.9",
    "motion-v": "2.4.2",
    "reka-ui": "2.10.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.10"
  }
}
