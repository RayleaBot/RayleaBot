{
  "$comment": "Code generated by scripts/generate-launcher-api.py; DO NOT EDIT.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LivenessStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        }
      }
    },
    "ReadinessStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "degraded",
            "setup_required",
            "failed"
          ]
        },
        "reason": {
          "type": "string"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "config": {
              "type": "string"
            },
            "database": {
              "type": "string"
            },
            "runtime": {
              "type": "string"
            },
            "render": {
              "type": "string"
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiagnosticIssue"
          }
        }
      }
    },
    "DiagnosticIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "summary"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "ok",
            "warning",
            "error"
          ]
        },
        "summary": {
          "type": "string"
        },
        "user_message": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "internal_reason": {
          "type": "string"
        },
        "runtime_resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "可通过运行环境准备任务处理的资源；省略时客户端不推断准备目标。",
          "items": {
            "type": "string",
            "enum": [
              "chromium",
              "ffmpeg"
            ]
          }
        }
      }
    },
    "SystemStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "adapters"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "running",
            "shutting_down"
          ]
        },
        "adapters": {
          "type": "array",
          "description": "按配置顺序返回实例状态；无实例时为 []，不构造占位连接。",
          "items": {
            "$ref": "#/$defs/AdapterStatus"
          }
        },
        "active_plugins": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of plugin runtimes currently active."
        },
        "running_plugins": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of plugins currently in the running state."
        },
        "failed_plugins": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of plugins currently in the failed state."
        },
        "db_schema_version": {
          "type": "string",
          "description": "Current database schema migration version."
        },
        "uptime_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "health": {
          "$ref": "#/$defs/ReadinessStatusResponse"
        }
      }
    },
    "AdapterStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol",
        "enabled",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "$ref": "#/$defs/AdapterProtocol"
        },
        "enabled": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/AdapterState"
        }
      }
    },
    "AdapterProtocol": {
      "type": "string",
      "description": "正式支持的聊天适配器标识。集合随正式接入的适配器增长；管理面按此值区分协议， 不从会话种类或标识符格式推断来源。\n",
      "enum": [
        "onebot11",
        "qqofficial"
      ]
    },
    "AdapterState": {
      "type": "string",
      "description": "适配器连接状态，与聊天传输状态共用词表。",
      "enum": [
        "idle",
        "listening",
        "connecting",
        "connected",
        "auth_failed",
        "reconnecting",
        "stopped"
      ]
    },
    "SystemShutdownResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      }
    }
  }
}
