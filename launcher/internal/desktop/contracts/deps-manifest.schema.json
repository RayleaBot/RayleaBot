{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/deps-manifest.schema.json",
  "title": "RayleaBot Managed Dependencies Manifest",
  "description": "Managed Chromium and FFmpeg resources. Every entry is validated before use; IDs and versions are portable path segments. Resource IDs and platform/kind pairs, and source URLs within each resource, must be unique. Source URLs require HTTPS, a nonempty hostname, and no credentials or fragment. Entrypoints are canonical relative slash paths; every candidate must be valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "resources"
  ],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "const": 5
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows-x64",
        "linux-x64",
        "macos-arm64"
      ]
    },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "kind"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@\\s]+(?:[/?][^\\s#]*)?$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "upstream",
            "mirror"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entrypointCandidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\:\u0000-\u001f<>\"|?*]+(?:/[^/\\\\:\u0000-\u001f<>\"|?*]+)*$",
        "not": {
          "anyOf": [
            {
              "pattern": "(^|/)(\\.{1,2}|[^/]*[ .])(/|$)"
            },
            {
              "pattern": "(^|/)(?:[Cc][Oo][Nn](?:[Ii][Nn]\\$|[Oo][Uu][Tt]\\$)?|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|(?:[Cc][Oo][Mm]|[Ll][Pp][Tt])[1-9¹²³]) *(?:\\.[^/]*)?(/|$)"
            }
          ]
        }
      },
      "uniqueItems": true
    },
    "chromiumEntrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser"
      ],
      "properties": {
        "browser": {
          "$ref": "#/$defs/entrypointCandidates"
        }
      }
    },
    "ffmpegEntrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ffmpeg",
        "ffprobe"
      ],
      "properties": {
        "ffmpeg": {
          "$ref": "#/$defs/entrypointCandidates"
        },
        "ffprobe": {
          "$ref": "#/$defs/entrypointCandidates"
        }
      }
    },
    "resourceBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "platform",
        "sources",
        "sha256",
        "archive_format",
        "entrypoints"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "not": {
            "anyOf": [
              {
                "pattern": "[ .]$"
              },
              {
                "pattern": "^(?:[Cc][Oo][Nn](?:[Ii][Nn]\\$|[Oo][Uu][Tt]\\$)?|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|(?:[Cc][Oo][Mm]|[Ll][Pp][Tt])[1-9¹²³]) *(?:\\.[^/]*)?$"
              }
            ]
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "chromium",
            "ffmpeg"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "not": {
            "anyOf": [
              {
                "pattern": "[ .]$"
              },
              {
                "pattern": "^(?:[Cc][Oo][Nn](?:[Ii][Nn]\\$|[Oo][Uu][Tt]\\$)?|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|(?:[Cc][Oo][Mm]|[Ll][Pp][Tt])[1-9¹²³]) *(?:\\.[^/]*)?$"
              }
            ]
          }
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceEntry"
          },
          "description": "可信资源来源列表；下载器按当前网络测速选择来源，测速不可用时按列表顺序尝试；每项 url 必须唯一。"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "archive_format": {
          "type": "string",
          "enum": [
            "zip",
            "tar.gz",
            "tar.xz"
          ]
        },
        "entrypoints": {
          "type": "object"
        }
      }
    },
    "chromiumResource": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceBase"
        },
        {
          "properties": {
            "kind": {
              "const": "chromium"
            }
          }
        },
        {
          "properties": {
            "entrypoints": {
              "$ref": "#/$defs/chromiumEntrypoints"
            }
          }
        }
      ]
    },
    "ffmpegResource": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceBase"
        },
        {
          "properties": {
            "kind": {
              "const": "ffmpeg"
            },
            "entrypoints": {
              "$ref": "#/$defs/ffmpegEntrypoints"
            }
          }
        }
      ]
    },
    "resource": {
      "oneOf": [
        {
          "$ref": "#/$defs/chromiumResource"
        },
        {
          "$ref": "#/$defs/ffmpegResource"
        }
      ]
    }
  },
  "x-fixtures": [
    "fixtures/deps-manifest/edge.entrypoint-unicode-space.json",
    "fixtures/deps-manifest/edge.multi-platform-managed-runtimes.json",
    "fixtures/deps-manifest/invalid.bad-archive-format.json",
    "fixtures/deps-manifest/invalid.duplicate-resource.json",
    "fixtures/deps-manifest/invalid.duplicate-source-url.json",
    "fixtures/deps-manifest/invalid.empty-sources.json",
    "fixtures/deps-manifest/invalid.entrypoint-dot.json",
    "fixtures/deps-manifest/invalid.entrypoint-inner-parent.json",
    "fixtures/deps-manifest/invalid.entrypoint-mixed-candidates.json",
    "fixtures/deps-manifest/invalid.entrypoint-parent-path.json",
    "fixtures/deps-manifest/invalid.entrypoint-unc.json",
    "fixtures/deps-manifest/invalid.entrypoint-windows-device.json",
    "fixtures/deps-manifest/invalid.id-traversal.json",
    "fixtures/deps-manifest/invalid.id-windows-device.json",
    "fixtures/deps-manifest/invalid.missing-entrypoints.json",
    "fixtures/deps-manifest/invalid.missing-sources.json",
    "fixtures/deps-manifest/invalid.nonhex-digest.json",
    "fixtures/deps-manifest/invalid.source-credentials.json",
    "fixtures/deps-manifest/invalid.source-empty-host.json",
    "fixtures/deps-manifest/invalid.source-fragment.json",
    "fixtures/deps-manifest/invalid.unknown-source-kind.json",
    "fixtures/deps-manifest/invalid.version-trailing-dot.json",
    "fixtures/deps-manifest/invalid.version-traversal.json",
    "fixtures/deps-manifest/ok.minimal.json",
    "fixtures/deps-manifest/ok.multi-source.json"
  ]
}
