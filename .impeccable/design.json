  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "当前工作流唯一突出的主操作：蓝色胶囊配白色文字。",
      "html": "<button class=\"ds-btn-primary\">创建备份</button>",
      "css": ".ds-btn-primary { height: 40px; padding: 0 18px; border: 0; border-radius: 999px; background: #2860D8; color: #FFFFFF; font: 700 14px/1.4 'HarmonyOS Sans SC', 'Microsoft YaHei UI', sans-serif; cursor: pointer; box-shadow: 0 1px 2px #18161214, 0 3px 8px -4px #18161224; transition: background-color 160ms cubic-bezier(0.16, 1, 0.3, 1); } .ds-btn-primary:hover { background: #1F52C0; } .ds-btn-primary:focus-visible { outline: 2px solid #FFFFFF; outline-offset: -4px; } .ds-btn-primary:active { background: #1A47A8; } .ds-btn-primary:disabled { cursor: not-allowed; opacity: 0.58; } @media (prefers-color-scheme: dark) { .ds-btn-primary { background: #3567DC; color: #FFFFFF; box-shadow: 0 1px 2px #00000066, 0 3px 8px -4px #00000080; } .ds-btn-primary:hover { background: #2B5BD0; } .ds-btn-primary:active { background: #2451BF; } }"
    },
    {
      "name": "Attention Button",
