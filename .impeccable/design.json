      "html": "<button class=\"ds-btn-primary\">保存设置</button>",
      "css": ".ds-btn-primary { height: 36px; padding: 8px 14px; border: 1px solid #476C5E; border-radius: 8px; background: #476C5E; color: #FFFFFF; font: 600 14px/1.4 \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif; cursor: pointer; transition: background-color 160ms cubic-bezier(0.16, 1, 0.3, 1), border-color 160ms cubic-bezier(0.16, 1, 0.3, 1); } .ds-btn-primary:hover { background: #365749; border-color: #365749; } .ds-btn-primary:focus-visible { outline: 2px solid #555555; outline-offset: 2px; } .ds-btn-primary:active { background: #294438; border-color: #294438; } .ds-btn-primary:disabled { cursor: not-allowed; opacity: 0.58; } @media (prefers-color-scheme: dark) { .ds-btn-primary { border-color: #A3C5B3; background: #A3C5B3; color: #18281F; } .ds-btn-primary:hover { border-color: #BBD0C1; background: #BBD0C1; } .ds-btn-primary:focus-visible { outline-color: #C0C0C0; } .ds-btn-primary:active { border-color: #80A48F; background: #80A48F; } }"
