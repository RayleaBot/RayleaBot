      "css": ".ds-btn-attention { height: 36px; padding: 8px 14px; border: 1px solid #9B4A2F; border-radius: 10px; background: #9B4A2F; color: #FFFFFF; font: 600 14px/1.4 Inter, system-ui, sans-serif; cursor: pointer; } .ds-btn-attention:focus-visible { outline: 2px solid #9F356C; outline-offset: 2px; } @media (prefers-color-scheme: dark) { .ds-btn-attention { border-color: #E08A61; background: #E08A61; color: #27101E; } .ds-btn-attention:focus-visible { outline-color: #F0A4C9; } }"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "带持续标签、控件边界和清晰焦点的标准输入框。",
      "html": "<label class=\"ds-field\"><span>服务地址</span><input value=\"http://127.0.0.1:8080\"></label>",
      "css": ".ds-field { display: grid; gap: 6px; color: #211820; font: 600 13px/1.4 Inter, system-ui, sans-serif; } .ds-field input { width: 100%; height: 36px; padding: 8px 12px; border: 1px solid #93868E; border-radius: 10px; background: #FFFFFF; color: #211820; font: 400 14px/1.55 Inter, system-ui, sans-serif; } .ds-field input:focus-visible { outline: 2px solid #9F356C; outline-offset: 2px; } @media (prefers-color-scheme: dark) { .ds-field { color: #F4EDF1; } .ds-field input { border-color: #806C78; background: #282127; color: #F4EDF1; } .ds-field input:focus-visible { outline-color: #F0A4C9; } }"
    },
    {
      "name": "Selected Navigation Item",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "使用完整色面、文字和定位器表达当前工作区。",
      "html": "<a class=\"ds-nav-item\" href=\"#\" aria-current=\"page\">⌖ 系统状态</a>",
      "css": ".ds-nav-item { display: inline-flex; align-items: center; min-height: 40px; padding: 8px 12px; border-radius: 10px; background: #6C204B; color: #FFF4F9; font: 600 14px/1.4 Inter, system-ui, sans-serif; text-decoration: none; } .ds-nav-item:focus-visible { outline: 2px solid #E8AAC7; outline-offset: 2px; } @media (prefers-color-scheme: dark) { .ds-nav-item { background: #3F1830; color: #FFF4F9; } .ds-nav-item:focus-visible { outline-color: #E8AAC7; } }"
    },
    {
      "name": "Status Chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "同时使用语义色、文字和形状表达状态。",
      "html": "<span class=\"ds-status-chip\">● 运行正常</span>",
      "css": ".ds-status-chip { display: inline-flex; align-items: center; min-height: 24px; padding: 4px 8px; border: 1px solid #227653; border-radius: 999px; background: #E8F4EE; color: #227653; font: 600 13px/1.4 Inter, system-ui, sans-serif; } @media (prefers-color-scheme: dark) { .ds-status-chip { border-color: #65D39A; background: #193429; color: #65D39A; } }"
    },
    {
      "name": "Section Surface",
      "kind": "card",
      "refersTo": "section-surface",
      "description": "只承载具有独立任务边界的内容。",
      "html": "<section class=\"ds-section-surface\"><h3>运行环境</h3><p>检查托管运行时与模板资源。</p></section>",
      "css": ".ds-section-surface { max-width: 560px; padding: 16px; border: 1px solid #DDD4D9; border-radius: 14px; background: #FFFBFD; color: #211820; font: 400 14px/1.55 Inter, system-ui, sans-serif; } .ds-section-surface h3 { margin: 0 0 8px; font-size: 18px; } .ds-section-surface p { margin: 0; color: #6B5E66; } @media (prefers-color-scheme: dark) { .ds-section-surface { border-color: #41363D; background: #1D181C; color: #F4EDF1; } .ds-section-surface p { color: #BAADB4; } }"
    },
    {
