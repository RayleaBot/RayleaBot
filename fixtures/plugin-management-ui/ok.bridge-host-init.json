{
  "contract": "contracts/plugin-management-ui-bridge.schema.json",
  "case": "ok",
  "description": "After the MessageChannel handoff, the host initializes only the bounded plugin page context.",
  "input": {
    "version": "2",
    "source": "management_host",
    "type": "host.init",
    "payload": {
      "plugin": {
        "id": "example-config-panel",
        "name": "Example Config Panel",
        "version": "0.2.0",
        "state": "disabled"
      },
      "page": {
        "id": "config",
        "label": "配置页面"
      },
      "config": {
        "default_city": "上海",
        "unit": "fahrenheit"
      },
      "secrets_configured": {
        "weather_api_key": true
      },
      "theme": {
        "mode": "dark",
        "tokens": {
          "colorPrimary": "#1677ff",
          "colorText": "#f5f5f5"
        }
      },
      "language": "zh-CN",
      "allowed_capabilities": [
        "config.read",
        "config.write"
      ]
    }
  },
  "expect": {
    "valid": true
  }
}
