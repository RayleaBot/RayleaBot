{
  "contract": "contracts/plugin-info.schema.json",
  "case": "ok",
  "input": {
    "id": "weather",
    "name": "Weather",
    "version": "1.0.0",
    "manifest_version": "2",
    "plugin_protocol_version": "1",
    "runtime": "go",
    "entry": "bin/weather",
    "license": "MIT",
    "description": "Weather query plugin with command declarations",
    "author": "raylea",
    "role": "user",
    "capabilities": [
      "event.subscribe"
    ],
    "default_config": {
      "default_city": "北京",
      "unit": "celsius"
    },
    "commands": [
      {
        "name": "天气",
        "aliases": [
          "weather",
          "天气？"
        ],
        "description": "查询指定城市天气",
        "usage": "/天气 <城市> [--days=N]",
        "permission": "everyone"
      },
      {
        "name": "weather-admin",
        "description": "管理天气数据源",
        "permission": "super_admin"
      }
    ],
    "platforms": [
      "windows-x64",
      "linux-x64",
      "macos-arm64"
    ]
  },
  "expect": {
    "valid": true
  }
}
