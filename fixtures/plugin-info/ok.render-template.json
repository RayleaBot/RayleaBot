{
  "contract": "contracts/plugin-info.schema.json",
  "case": "ok",
  "description": "A plugin may declare package-local render template directories.",
  "input": {
    "id": "weather-card",
    "name": "Weather Card",
    "version": "1.0.0",
    "manifest_version": "2",
    "plugin_protocol_version": "1",
    "runtime": "go",
    "entry": "bin/weather-card",
    "license": "MIT",
    "description": "Weather plugin with a local render card.",
    "author": "raylea",
    "capabilities": [
      "event.subscribe",
      "render.image"
    ],
    "render_templates": [
      {
        "path": "templates/card"
      }
    ],
    "platforms": [
      "windows-x64",
      "linux-x64",
      "macos-arm64"
    ]
  },
  "expect": {
    "valid": true
  }
}
