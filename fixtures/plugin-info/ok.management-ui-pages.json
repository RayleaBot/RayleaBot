{
  "contract": "contracts/plugin-info.schema.json",
  "case": "ok",
  "description": "A plugin may declare multiple package-local management page entries.",
  "input": {
    "id": "example-config-panel",
    "name": "Example Config Panel",
    "version": "0.1.0",
    "manifest_version": "2",
    "plugin_protocol_version": "1",
    "runtime": "go",
    "entry": "bin/example-config-panel",
    "license": "MIT",
    "description": "Python example plugin demonstrating config.read and config.write.",
    "author": "raylea",
    "role": "example",
    "management_ui": {
      "pages": [
        {
          "id": "config",
          "label": "配置页面",
          "entry": "web/index.html"
        },
        {
          "id": "secrets",
          "label": "密钥设置",
          "entry": "web/secrets.html"
        }
      ]
    },
    "capabilities": [
      "event.subscribe",
      "config.read",
      "config.write"
    ],
    "default_config": {
      "default_city": "北京",
      "unit": "celsius"
    },
    "platforms": [
      "windows-x64",
      "linux-x64",
      "macos-arm64"
    ]
  },
  "expect": {
    "valid": true
  }
}
