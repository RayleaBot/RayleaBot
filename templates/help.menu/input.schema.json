{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "prefix_chips": {
      "type": "array",
      "description": "Prefixes that address one plugin, dedicated ones first. Present on a plugin page and on the cards of plugins that declare dedicated prefixes.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "dedicated"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "dedicated": {
            "type": "boolean"
          }
        }
      }
    },
    "usage_part": {
      "type": "object",
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["literal", "required", "optional"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["title"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "render_footer": {
      "type": "string"
    },
    "command_prefixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prefix_chips": {
      "$ref": "#/$defs/prefix_chips"
    },
    "trigger_examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user": {
      "type": "object",
      "properties": {
        "avatar_url": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "id": {
          "type": ["string", "number"]
        }
      },
      "additionalProperties": true
    },
    "group": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "permission": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["super_admin", "owner", "admin", "member"]
        }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "type": "string"
          },
          "trigger_type": {
            "type": "string",
            "enum": ["exact", "setting", "pattern"]
          },
          "usage_args": {
            "type": "string"
          },
          "usage_parts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/usage_part"
            }
          },
          "command_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prefix_chips": {
            "$ref": "#/$defs/prefix_chips"
          },
          "primary_prefix": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "enum": ["everyone", "group_admin", "super_admin"]
          },
          "permission_label": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "items"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "usage": {
                  "type": "string"
                },
                "trigger_type": {
                  "type": "string",
                  "enum": ["exact", "setting", "pattern"]
                },
                "usage_args": {
                  "type": "string"
                },
                "usage_parts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/usage_part"
                  }
                },
                "command_prefixes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "primary_prefix": {
                  "type": "string"
                },
                "permission": {
                  "type": "string",
                  "enum": ["everyone", "group_admin", "super_admin"]
                },
                "permission_label": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
