{
  "id": "raylea.echo",
  "name": "Echo Fixture",
  "version": "0.2.0",
  "manifest_version": "3",
  "license": "MIT",
  "commands": [
    {
      "id": "echo",
      "name": "echo",
      "description": "Echo fixture command",
      "usage": "/echo <text>",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "echo"
        ]
      }
    }
  ],
  "min_core_version": "0.4.0",
  "metadata": {
    "description": "Compiled test fixture for runtime and recovery tests",
    "author": "raylea"
  },
  "events": [
    "message.group",
    "message.private",
    "config.changed",
    "scheduler.trigger"
  ],
  "permissions": {
    "message.send": true,
    "render.image": true,
    "scheduler.create": true
  }
}
