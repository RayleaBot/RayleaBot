{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/plugin-info.schema.json",
  "title": "RayleaBot Plugin Manifest v4",
  "description": "The formal manifest contract for language-neutral native RayleaBot plugins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "manifest_version", "license", "min_core_version"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$", "description": "Stable plugin identifier assigned to the process by the host during init." },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/semver" },
    "manifest_version": { "type": "string", "const": "4" },
    "license": { "type": "string", "minLength": 1 },
    "min_core_version": { "$ref": "#/$defs/semver", "description": "Manifest v4 requires RayleaBot 0.7.0 or later; earlier versions and 0.7.0 prereleases are rejected." },
    "metadata": { "$ref": "#/$defs/metadata" },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 128, "default": 1 },
    "priority": { "$ref": "#/$defs/message_priority" },
    "block": { "$ref": "#/$defs/message_block" },
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/event_name" },
      "uniqueItems": true,
      "description": "Static event subscriptions. An omitted or empty list receives no ordinary event fan-out."
    },
    "default_config": { "type": "object", "additionalProperties": true, "description": "Defaults are merged with explicit persisted overrides when reading settings and creating init snapshots. Starting or reloading a plugin does not persist defaults. Unsaved keys follow manifest default changes; explicitly saved values, including values equal to a prior default, remain overrides." },
    "commands": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/command" } },
    "command_groups": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/command_group" } },
    "help": { "$ref": "#/$defs/help" },
    "management_ui": { "$ref": "#/$defs/management_ui" },
    "webhooks": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/webhook" } }
  },
  "allOf": [
    { "properties": { "min_core_version": { "not": { "anyOf": [{ "pattern": "^0\\.[0-6]\\." }, { "pattern": "^0\\.7\\.0-" }] } } } }
  ],
  "$defs": {
    "message_priority": { "type": "integer", "minimum": -1000, "maximum": 1000, "default": 0, "description": "Incoming-message priority: greater first, equal priorities concurrent. A positive-priority message subscriber that does not declare a matched command also receives that command message before its declarers. Other event types retain their existing dispatch behavior." },
    "message_block": { "type": "boolean", "default": false, "description": "Successful message terminal frames stop later priority layers unless propagation explicitly says continue. A not-handled or failed event continues. Same-layer work is not undone; terminal action sending finishes before layer advancement but sending failure does not alter propagation." },
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "https_url": { "type": "string", "format": "uri", "pattern": "^https://.+$" },
    "package_relative_path": {
      "allOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "(^|/)\\.\\.(/|$)" } }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/package_relative_path" },
        "repo": { "$ref": "#/$defs/https_url" },
        "homepage": { "$ref": "#/$defs/https_url" },
        "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "screenshots": { "type": "array", "items": { "$ref": "#/$defs/screenshot" } }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "alt"],
      "properties": {
        "path": { "$ref": "#/$defs/package_relative_path" },
        "alt": { "type": "string", "minLength": 1 }
      }
    },
    "event_name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
    "permission_level": { "type": "string", "enum": ["super_admin", "group_admin", "everyone"] },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "usage", "trigger"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "usage": { "type": "string", "minLength": 1 },
        "permission": { "$ref": "#/$defs/permission_level" },
        "trigger": {
          "oneOf": [
            { "$ref": "#/$defs/exact_trigger" },
            { "$ref": "#/$defs/pattern_trigger" },
            { "$ref": "#/$defs/setting_trigger" }
          ]
        }
      }
    },
    "stable_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$" },
    "exact_trigger": {
      "type": "object", "additionalProperties": false, "required": ["type", "names"],
      "properties": {
        "type": { "const": "exact" },
        "names": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^\\S+$" } }
      }
    },
    "pattern_trigger": {
      "type": "object", "additionalProperties": false, "required": ["type", "pattern"],
      "properties": {
        "type": { "const": "pattern" },
        "pattern": { "type": "string", "minLength": 1 }
      }
    },
    "setting_trigger": {
      "type": "object", "additionalProperties": false, "required": ["type", "settings_key"],
      "properties": {
        "type": { "const": "setting" },
        "settings_key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "command_group": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "commands"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "title": { "type": "string", "minLength": 1 },
        "commands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stable_id" } }
      }
    },
    "help": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "management_ui": {
      "type": "object", "additionalProperties": false, "required": ["entry", "pages"],
      "properties": {
        "entry": {
          "allOf": [
            { "$ref": "#/$defs/package_relative_path" },
            { "type": "string", "pattern": "\\.html$" }
          ]
        },
        "pages": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/stable_id" },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "description": "Route-only forwarding. The host checks source_cidrs and max_body_bytes and delivers request headers with the raw body; plugins verify signatures and handle duplicate deliveries.",
      "required": ["id", "route"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "route": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,31})$" },
        "source_cidrs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "max_body_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }
      }
    }
  },
  "x-fixtures": [
    "fixtures/plugin-info/ok.minimal-native.json",
    "fixtures/plugin-info/ok.commands.json",
    "fixtures/plugin-info/ok.management-ui-and-webhook.json",
    "fixtures/plugin-info/edge.empty-events.json",
    "fixtures/plugin-info/invalid.legacy-v3.json",
    "fixtures/plugin-info/invalid.command-group-reference.json",
    "fixtures/plugin-info/ok.priority-block.json",
    "fixtures/plugin-info/invalid.priority-range.json",
    "fixtures/plugin-info/invalid.min-core-before-v4.json",
    "fixtures/plugin-info/invalid.min-core-prerelease.json",
    "fixtures/plugin-info/invalid.filter-stage.json"
  ]
}
