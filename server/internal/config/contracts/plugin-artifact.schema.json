{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/plugin-artifact.schema.json",
  "title": "RayleaBot Plugin Artifact v2",
  "description": "Language-neutral inventory for one prebuilt native plugin package. Plugin identity and version are read from info.json; artifact.json is excluded from its own inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version",
    "target_platform",
    "entry",
    "files"
  ],
  "properties": {
    "artifact_version": {
      "type": "string",
      "const": "2"
    },
    "target_platform": {
      "$ref": "#/$defs/platform"
    },
    "entry": {
      "$ref": "#/$defs/path",
      "description": "Package-relative native executable selected for target_platform."
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows-x64",
        "linux-x64",
        "macos-arm64"
      ]
    },
    "path": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)artifact\\.json$"
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "x-fixtures": [
    "fixtures/plugin-artifact/ok.minimal.json",
    "fixtures/plugin-artifact/invalid.artifact-self-entry.json",
    "fixtures/plugin-artifact/edge.with-ui-and-templates.json"
  ]
}
