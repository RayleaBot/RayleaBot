{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/plugin-artifact.schema.json",
  "title": "RayleaBot Plugin Artifact v2",
  "description": "Language-neutral entry descriptor for one prebuilt native plugin package. Plugin identity and version are read from info.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version",
    "target_platform",
    "entry"
  ],
  "properties": {
    "artifact_version": {
      "type": "string",
      "const": "2"
    },
    "target_platform": {
      "$ref": "#/$defs/platform"
    },
    "entry": {
      "$ref": "#/$defs/path",
      "description": "Package-relative native executable selected for target_platform."
    }
  },
  "$defs": {
    "platform": {
      "type": "string",
      "enum": [
        "windows-x64",
        "linux-x64",
        "macos-arm64"
      ]
    },
    "path": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)artifact\\.json$"
          }
        }
      ]
    }
  },
  "x-fixtures": [
    "fixtures/plugin-artifact/ok.minimal.json",
    "fixtures/plugin-artifact/invalid.artifact-self-entry.json",
    "fixtures/plugin-artifact/edge.with-ui-and-templates.json"
  ]
}
