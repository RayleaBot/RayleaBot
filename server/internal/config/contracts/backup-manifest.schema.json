{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/backup-manifest.schema.json",
  "title": "RayleaBot Backup Manifest",
  "description": "Formal schema for current-format backup-manifest.json used by backup, restore, launcher fallback and fresh-install recovery drills.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "created_at",
    "core_version",
    "config_schema_version",
    "db_schema_version",
    "plugin_manifest_version",
    "plugin_protocol_version",
    "plugin_artifact_version",
    "plugin_ui_bridge_version",
    "consistency",
    "directories"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "3"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "core_version": {
      "description": "Installed build version, or unknown when valid build metadata is unavailable. Unknown is not a semantic version and must not participate in version ordering.",
      "anyOf": [
        {
          "$ref": "#/$defs/semver"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "config_schema_version": {
      "type": "string",
      "const": "4",
      "description": "Current schema version read from the archived user configuration."
    },
    "db_schema_version": {
      "type": "string",
      "enum": [
        "000001",
        "absent"
      ],
      "description": "Current schema version read from the archived SQLite initialization metadata; absent means no database was included."
    },
    "plugin_manifest_version": {
      "type": "string",
      "const": "3"
    },
    "plugin_protocol_version": {
      "type": "string",
      "const": "3"
    },
    "plugin_artifact_version": {
      "type": "string",
      "const": "2"
    },
    "plugin_ui_bridge_version": {
      "type": "string",
      "const": "3"
    },
    "consistency": {
      "type": "string",
      "enum": [
        "offline",
        "online"
      ]
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      },
      "uniqueItems": true
    },
    "directories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/directory"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "directory": {
      "type": "object",
      "description": "A restorable archive root. config contains the effective user configuration, database identifies the canonical SQLite snapshot, data contains non-database runtime and plugin business data, and plugins contains installed plugin artifacts. Database restoration uses the archived effective configuration: portable relative paths are retained inside the target root; absolute source paths become data/rayleabot.db. Unsafe relative paths are rejected.",
      "additionalProperties": false,
      "required": [
        "label",
        "path"
      ],
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "config",
            "database",
            "data",
            "plugins"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "manifest_version",
        "protocol_version",
        "artifact_version"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "manifest_version": {
          "type": "string",
          "const": "3"
        },
        "protocol_version": {
          "type": "string",
          "const": "3"
        },
        "artifact_version": {
          "type": "string",
          "const": "2"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "min_core_version": {
          "$ref": "#/$defs/semver"
        },
        "source_root": {
          "type": "string",
          "enum": [
            "plugins/installed"
          ]
        }
      }
    }
  },
  "x-fixtures": [
    "fixtures/backup-manifest/ok.minimal.json",
    "fixtures/backup-manifest/ok.unknown-core-version.json",
    "fixtures/backup-manifest/edge.config-only.json",
    "fixtures/backup-manifest/invalid.missing-schema-versions.json",
    "fixtures/backup-manifest/edge.plugin-inventory.json"
  ]
}
