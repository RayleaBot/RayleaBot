# RayleaBot 本地开发启动参数。
# 复制本文件为 .env；父进程已经设置的同名环境变量优先。

# 启动模式：web-dev、build 或 launcher-dev。
RAYLEA_START_PROFILE=web-dev

# 依赖安装策略：auto、always 或 skip。
RAYLEA_START_INSTALL=auto

# 本地插件工作区文件；相对路径以主仓库根目录为基准。
RAYLEA_PLUGIN_WORKSPACE=plugin-workspace.local.json

# 插件开发模式：off、sync 或 watch。
# watch 会在首次全量同步后只重新构建发生变化的插件。
RAYLEA_PLUGIN_DEV=watch

# Server 源码重载模式。RAYLEA_PLUGIN_DEV=watch 时必须同时设为 watch。
# 插件新产物构建并同步后，Server 会短暂重启。
RAYLEA_SERVER_RELOAD=watch

# Web 开发代理的后端地址；留空时读取 config/user.yaml 中的
# server.host 和 server.port。
VITE_BACKEND_TARGET=

# WebSocket 后端地址；留空时跟随 VITE_BACKEND_TARGET。
VITE_WS_BASE_URL=

# Launcher 打开的管理面地址；留空时使用 http://127.0.0.1:4173/。
RAYLEA_WEB_UI_BASE_URL=

# 设为 1 时只完成准备工作而不打开 Electron；0 表示打开 Launcher。
RAYLEA_START_SKIP_LAUNCH=0

# RAYLEA_START_NODE 和 RAYLEA_START_NO_PAUSE 属于批处理引导参数，必须在
# 运行 start.bat 前由父进程设置；写在本文件中不能影响 Node.js 选择或失败暂停。
# Launcher 生成的 setup/control token 属于内部密钥，不应写入本文件。
