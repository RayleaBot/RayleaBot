{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/release-manifest.schema.json",
  "title": "RayleaBot Release Metadata",
  "description": "Release version information for update notices and packaged build_info.json. Release tooling generates and validates metadata strictly against this schema. Readers ignore unknown fields and validate only the fields they use; release metadata is not a security boundary.",
  "oneOf": [
    {
      "$ref": "#/$defs/releaseManifestV2"
    },
    {
      "$ref": "#/$defs/buildInfo"
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{7,40}$"
    },
    "artifactId": {
      "type": "string",
      "enum": [
        "windows-x64-full",
        "linux-x64-full",
        "macos-arm64-full",
        "linux-x64-server"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "file_name",
        "platform",
        "archive_size_bytes",
        "expanded_size_bytes",
        "file_count",
        "update_mode",
        "support_level",
        "smoke_profile"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "file_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$",
          "description": "Release asset basename. Directory separators, drive prefixes and parent paths are not valid."
        },
        "platform": {
          "type": "string",
          "enum": [
            "windows-x64",
            "linux-x64",
            "macos-arm64"
          ]
        },
        "archive_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "expanded_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "update_mode": {
          "type": "string",
          "enum": [
            "guided",
            "manual"
          ],
          "description": "Informational update method. Update checks pass it through unchanged and do not branch on it."
        },
        "support_level": {
          "type": "string",
          "enum": [
            "first_class",
            "experimental"
          ]
        },
        "smoke_profile": {
          "type": "string",
          "enum": [
            "windows_full_smoke",
            "linux_full_smoke",
            "macos_full_smoke",
            "linux_server_smoke"
          ]
        }
      }
    },
    "releaseManifestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_version",
        "version",
        "git_commit",
        "built_at",
        "channel",
        "published_at",
        "config_schema_version",
        "db_schema_version",
        "plugin_protocol_version",
        "plugin_manifest_version",
        "plugin_ui_bridge_version",
        "artifacts",
        "release_notes_ref"
      ],
      "properties": {
        "manifest_version": {
          "const": 2
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "git_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "built_at": {
          "type": "string",
          "format": "date-time"
        },
        "channel": {
          "type": "string",
          "enum": [
            "stable",
            "beta"
          ]
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "config_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "db_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "plugin_protocol_version": {
          "const": "3",
          "description": "Informational only. Readers do not compare it; plugin compatibility is stated in release notes."
        },
        "plugin_manifest_version": {
          "const": "3",
          "description": "Informational only. Readers do not compare it; plugin compatibility is stated in release notes."
        },
        "plugin_ui_bridge_version": {
          "const": "3",
          "description": "Informational only. Readers do not compare it; plugin compatibility is stated in release notes."
        },
        "onebot_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport_matrix_version",
            "compatibility_matrix_version",
            "provider_extension_matrix_version"
          ],
          "properties": {
            "transport_matrix_version": {
              "type": "string",
              "minLength": 1
            },
            "compatibility_matrix_version": {
              "type": "string",
              "minLength": 1
            },
            "provider_extension_matrix_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "release_notes_ref": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "buildInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "git_commit",
        "artifact_id",
        "built_at",
        "plugin_manifest_version",
        "plugin_ui_bridge_version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "git_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "built_at": {
          "type": "string",
          "format": "date-time"
        },
        "plugin_manifest_version": {
          "const": "3",
          "description": "Informational only. Readers do not compare it; plugin compatibility is stated in release notes."
        },
        "plugin_ui_bridge_version": {
          "const": "3",
          "description": "Informational only. Readers do not compare it; plugin compatibility is stated in release notes."
        },
        "release_notes_ref": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "onebot_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport_matrix_version",
            "compatibility_matrix_version",
            "provider_extension_matrix_version"
          ],
          "properties": {
            "transport_matrix_version": {
              "type": "string",
              "minLength": 1
            },
            "compatibility_matrix_version": {
              "type": "string",
              "minLength": 1
            },
            "provider_extension_matrix_version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "x-runtime-constraints": [
    "release tooling validates generated metadata against this schema and the release matrix; readers use only version, release_notes_ref and the artifact matching build_info.json"
  ],
  "x-fixtures": [
    "fixtures/release-manifest/ok.release-manifest-minimal.json",
    "fixtures/release-manifest/ok.build-info-minimal.json",
    "fixtures/release-manifest/edge.build-info-with-release-notes.json",
    "fixtures/release-manifest/invalid.artifact-non-basename.json",
    "fixtures/release-manifest/edge.multi-artifact-official-matrix.json"
  ]
}
