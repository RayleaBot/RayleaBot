{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/plugin-store-signature.schema.json",
  "title": "RayleaBot Plugin Store Catalog Signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["signature_version", "algorithm", "catalog_sha256", "key_id", "signatures"],
  "properties": {
    "signature_version": {
      "type": "integer",
      "const": 1
    },
    "algorithm": {
      "type": "string",
      "const": "ed25519"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "signature"],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "signature": {
            "type": "string",
            "minLength": 88,
            "maxLength": 88
          }
        }
      }
    }
  },
  "x-fixtures": [
    "fixtures/plugin-store-signature/ok.primary.json",
    "fixtures/plugin-store-signature/edge.key-rotation.json",
    "fixtures/plugin-store-signature/invalid.digest.json"
  ]
}
