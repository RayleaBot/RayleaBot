{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/plugin-info.schema.json",
  "title": "RayleaBot Plugin Manifest v3",
  "description": "The formal manifest contract for language-neutral native RayleaBot plugins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "manifest_version", "license", "min_core_version"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$", "description": "Stable plugin identifier assigned to the process by the host during init." },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/semver" },
    "manifest_version": { "type": "string", "const": "3" },
    "license": { "type": "string", "minLength": 1 },
    "min_core_version": { "$ref": "#/$defs/semver" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 128, "default": 1 },
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/event_name" },
      "uniqueItems": true,
      "description": "Static event subscriptions. An omitted or empty list receives no ordinary event fan-out."
    },
    "permissions": { "$ref": "#/$defs/permissions" },
    "default_config": { "type": "object", "additionalProperties": true, "description": "Defaults are merged with explicit persisted overrides when reading settings and creating init snapshots. Starting or reloading a plugin does not persist defaults. Unsaved keys follow manifest default changes; explicitly saved values, including values equal to a prior default, remain overrides." },
    "commands": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/command" } },
    "command_groups": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/command_group" } },
    "help": { "$ref": "#/$defs/help" },
    "management_ui": { "$ref": "#/$defs/management_ui" },
    "webhooks": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/webhook" } }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "https_url": { "type": "string", "format": "uri", "pattern": "^https://.+$" },
    "package_relative_path": {
      "allOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "(^|/)\\.\\.(/|$)" } }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/package_relative_path" },
        "repo": { "$ref": "#/$defs/https_url" },
        "homepage": { "$ref": "#/$defs/https_url" },
        "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "screenshots": { "type": "array", "items": { "$ref": "#/$defs/screenshot" } }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "alt"],
      "properties": {
        "path": { "$ref": "#/$defs/package_relative_path" },
        "alt": { "type": "string", "minLength": 1 }
      }
    },
    "event_name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
    "permission_name": {
      "type": "string",
      "enum": [
        "event.raw_payload", "message.send", "http.request",
        "governance.blacklist.read", "governance.blacklist.write",
        "governance.whitelist.read", "governance.whitelist.write",
        "governance.command_policy.read", "scheduler.create", "render.image",
        "plugin.list", "secret.read", "thirdparty.account.read",
        "thirdparty.account.validate", "thirdparty.resolve", "message.get",
        "message.delete", "message.history.get", "message.forward.get",
        "message.forward.send", "message.read.mark", "friend.request.handle",
        "friend.list", "friend.remark.set", "user.info.get", "user.like.send",
        "group.list", "group.info.get", "group.member.get", "group.member.list",
        "group.request.handle", "group.leave", "group.admin.set", "group.ban.set",
        "group.card.set", "group.title.set", "group.name.set",
        "group.announcement.list", "group.announcement.create", "group.announcement.delete",
        "group.essence.list", "group.essence.set", "group.essence.unset",
        "group.honor.get", "group.todo.set", "file.get", "file.download",
        "file.group.upload", "file.private.upload", "file.group.url.get",
        "file.private.url.get", "file.group.fs.info", "file.group.fs.list",
        "file.group.fs.mkdir", "file.group.fs.delete", "reaction.set",
        "reaction.list", "poke.send", "provider.napcat.message_emoji.like.set",
        "provider.napcat.group.sign.set", "provider.luckylillia.friend_groups.get"
      ]
    },
    "permissions": {
      "type": "object",
      "description": "Explicit elevated host permissions. Plugin-private logging, configuration, KV and file access are implicit and namespace-isolated.",
      "propertyNames": { "$ref": "#/$defs/permission_name" },
      "additionalProperties": { "const": true },
      "properties": {
        "thirdparty.account.read": { "$ref": "#/$defs/platform_permission" },
        "thirdparty.account.validate": { "$ref": "#/$defs/platform_permission" },
        "thirdparty.resolve": { "$ref": "#/$defs/resolve_permission" }
      }
    },
    "platform_permission": {
      "oneOf": [
        { "const": true },
        {
          "type": "object", "additionalProperties": false, "required": ["platforms"],
          "properties": {
            "platforms": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "enum": ["bilibili", "weibo", "douyin", "netease_music"] }
            }
          }
        }
      ]
    },
    "resolve_permission": {
      "oneOf": [
        { "const": true },
        {
          "type": "object", "additionalProperties": false, "required": ["platforms"],
          "properties": {
            "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "const": "douyin" } }
          }
        }
      ]
    },
    "permission_level": { "type": "string", "enum": ["super_admin", "group_admin", "everyone"] },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "usage", "trigger"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "usage": { "type": "string", "minLength": 1 },
        "permission": { "$ref": "#/$defs/permission_level" },
        "trigger": {
          "oneOf": [
            { "$ref": "#/$defs/exact_trigger" },
            { "$ref": "#/$defs/pattern_trigger" },
            { "$ref": "#/$defs/setting_trigger" }
          ]
        }
      }
    },
    "stable_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$" },
    "exact_trigger": {
      "type": "object", "additionalProperties": false, "required": ["type", "names"],
      "properties": {
        "type": { "const": "exact" },
        "names": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^\\S+$" } }
      }
    },
    "pattern_trigger": {
      "type": "object", "additionalProperties": false, "required": ["type", "pattern"],
      "properties": {
        "type": { "const": "pattern" },
        "pattern": { "type": "string", "minLength": 1 }
      }
    },
    "setting_trigger": {
      "type": "object", "additionalProperties": false, "required": ["type", "settings_key"],
      "properties": {
        "type": { "const": "setting" },
        "settings_key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "command_group": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "commands"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "title": { "type": "string", "minLength": 1 },
        "commands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stable_id" } }
      }
    },
    "help": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "management_ui": {
      "type": "object", "additionalProperties": false, "required": ["entry", "pages"],
      "properties": {
        "entry": {
          "allOf": [
            { "$ref": "#/$defs/package_relative_path" },
            { "type": "string", "pattern": "\\.html$" }
          ]
        },
        "pages": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/stable_id" },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "auth_strategy", "header", "secret_ref", "replay_protection"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "route": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,31})$" },
        "auth_strategy": { "type": "string", "enum": ["fixed_token", "hmac_sha256"] },
        "header": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "secret_ref": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_.-]{0,126}[a-z0-9])?$" },
        "signature_prefix": { "type": "string" },
        "source_cidrs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "max_body_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "replay_protection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timestamp_header", "event_id_header", "tolerance_seconds", "enforce"],
          "properties": {
            "timestamp_header": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
            "event_id_header": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
            "tolerance_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "enforce": { "type": "boolean" }
          }
        }
      }
    }
  },
  "x-fixtures": [
    "fixtures/plugin-info/ok.minimal-native.json",
    "fixtures/plugin-info/ok.commands-and-permissions.json",
    "fixtures/plugin-info/ok.management-ui-and-webhook.json",
    "fixtures/plugin-info/edge.empty-events-and-permissions.json",
    "fixtures/plugin-info/invalid.legacy-v2.json",
    "fixtures/plugin-info/invalid.command-group-reference.json"
  ]
}
