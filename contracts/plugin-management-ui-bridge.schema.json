{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/plugin-management-ui-bridge.schema.json",
  "title": "RayleaBot Plugin Management UI Bridge v2",
  "description": "Bridge v2 uses page.ready and host.connect only for a nonce-bound MessageChannel handoff. Every later message travels over the transferred port; plugin secrets are represented only by configured-state booleans or write/delete commands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "type"
  ],
  "properties": {
    "version": {
      "const": "2"
    },
    "source": {
      "type": "string",
      "enum": [
        "management_host",
        "plugin_management_ui"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "page.ready",
        "host.connect",
        "host.init",
        "settings.reload",
        "settings.save",
        "settings.changed",
        "secrets.status.reload",
        "secrets.status.changed",
        "secrets.set",
        "secrets.delete",
        "ui.resize",
        "scheduler.trigger",
        "scheduler.triggered",
        "render_template.open",
        "protocol.targets.reload",
        "protocol.targets.changed",
        "protocol.identities.resolve",
        "protocol.identities.resolved",
        "plugin.action.invoke",
        "plugin.action.result",
        "error"
      ]
    },
    "nonce": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "page.ready"
          }
        }
      },
      "then": {
        "required": [
          "nonce"
        ],
        "properties": {
          "source": {
            "const": "plugin_management_ui"
          },
          "payload": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "host.connect"
          }
        }
      },
      "then": {
        "required": [
          "nonce"
        ],
        "properties": {
          "source": {
            "const": "management_host"
          },
          "payload": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "not": {
              "enum": [
                "page.ready",
                "host.connect"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "nonce": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "host.init"
          }
        }
      },
      "then": {
        "required": [
          "payload"
        ],
        "properties": {
          "source": {
            "const": "management_host"
          },
          "payload": {
            "$ref": "#/$defs/host_init_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "settings.reload"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/plugin_request_without_payload"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "settings.save"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/plugin_config_request"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "settings.changed"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/host_config_message"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "secrets.status.reload"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/plugin_request_without_payload"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "secrets.status.changed"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/host_secret_status_message"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "secrets.set"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/plugin_secret_set_request"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "secrets.delete"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/plugin_secret_delete_request"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ui.resize"
          }
        }
      },
      "then": {
        "required": [
          "payload"
        ],
        "properties": {
          "source": {
            "const": "plugin_management_ui"
          },
          "payload": {
            "$ref": "#/$defs/resize_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "scheduler.trigger"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/plugin_scheduler_request"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "scheduler.triggered"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/host_scheduler_result"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "render_template.open"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/plugin_render_request"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "protocol.targets.reload",
              "protocol.identities.resolve",
              "plugin.action.invoke"
            ]
          }
        }
      },
      "then": {
        "required": [
          "request_id",
          "payload"
        ],
        "properties": {
          "source": {
            "const": "plugin_management_ui"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "protocol.targets.changed",
              "protocol.identities.resolved",
              "plugin.action.result"
            ]
          }
        }
      },
      "then": {
        "required": [
          "request_id",
          "payload"
        ],
        "properties": {
          "source": {
            "const": "management_host"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "payload"
        ],
        "properties": {
          "payload": {
            "$ref": "#/$defs/error_payload"
          }
        }
      }
    }
  ],
  "$defs": {
    "plugin_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "page_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "tokens"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "secret_status": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "host_init_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin",
        "page",
        "config",
        "secrets_configured",
        "theme",
        "language",
        "allowed_capabilities"
      ],
      "properties": {
        "plugin": {
          "$ref": "#/$defs/plugin_summary"
        },
        "page": {
          "$ref": "#/$defs/page_summary"
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "secrets_configured": {
          "$ref": "#/$defs/secret_status"
        },
        "theme": {
          "$ref": "#/$defs/theme"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "allowed_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "plugin_request_without_payload": {
      "required": [
        "request_id"
      ],
      "properties": {
        "source": {
          "const": "plugin_management_ui"
        },
        "payload": false
      }
    },
    "plugin_config_request": {
      "required": [
        "request_id",
        "payload"
      ],
      "properties": {
        "source": {
          "const": "plugin_management_ui"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config"
          ],
          "properties": {
            "config": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "host_config_message": {
      "required": [
        "payload"
      ],
      "properties": {
        "source": {
          "const": "management_host"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config"
          ],
          "properties": {
            "config": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "host_secret_status_message": {
      "required": [
        "payload"
      ],
      "properties": {
        "source": {
          "const": "management_host"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configured"
          ],
          "properties": {
            "configured": {
              "$ref": "#/$defs/secret_status"
            }
          }
        }
      }
    },
    "plugin_secret_set_request": {
      "required": [
        "request_id",
        "payload"
      ],
      "properties": {
        "source": {
          "const": "plugin_management_ui"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "plugin_secret_delete_request": {
      "required": [
        "request_id",
        "payload"
      ],
      "properties": {
        "source": {
          "const": "plugin_management_ui"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keys"
          ],
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "resize_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 1600
        }
      }
    },
    "plugin_scheduler_request": {
      "required": [
        "request_id",
        "payload"
      ],
      "properties": {
        "source": {
          "const": "plugin_management_ui"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job_id"
          ],
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "host_scheduler_result": {
      "required": [
        "request_id",
        "payload"
      ],
      "properties": {
        "source": {
          "const": "management_host"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job_id",
            "accepted"
          ],
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1
            },
            "accepted": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "plugin_render_request": {
      "required": [
        "payload"
      ],
      "properties": {
        "source": {
          "const": "plugin_management_ui"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "template_id"
          ],
          "properties": {
            "template_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "error_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "x-fixtures": [
    "fixtures/plugin-management-ui/ok.bridge-page-ready.json",
    "fixtures/plugin-management-ui/ok.bridge-host-connect.json",
    "fixtures/plugin-management-ui/ok.bridge-host-init.json",
    "fixtures/plugin-management-ui/ok.bridge-settings-save.json",
    "fixtures/plugin-management-ui/ok.bridge-settings-changed.json",
    "fixtures/plugin-management-ui/ok.bridge-secrets-set.json",
    "fixtures/plugin-management-ui/ok.bridge-secrets-delete.json",
    "fixtures/plugin-management-ui/ok.bridge-secrets-status-changed.json",
    "fixtures/plugin-management-ui/ok.bridge-ui-resize.json",
    "fixtures/plugin-management-ui/ok.bridge-scheduler-trigger.json",
    "fixtures/plugin-management-ui/ok.bridge-scheduler-triggered.json",
    "fixtures/plugin-management-ui/ok.bridge-render-template-open.json",
    "fixtures/plugin-management-ui/ok.bridge-protocol-targets-reload.json",
    "fixtures/plugin-management-ui/ok.bridge-protocol-targets-changed.json",
    "fixtures/plugin-management-ui/ok.bridge-protocol-identities-resolve.json",
    "fixtures/plugin-management-ui/ok.bridge-protocol-identities-resolved.json",
    "fixtures/plugin-management-ui/ok.bridge-plugin-action-invoke.json",
    "fixtures/plugin-management-ui/ok.bridge-plugin-action-result.json",
    "fixtures/plugin-management-ui/invalid.bridge-unknown-type.json"
  ]
}
