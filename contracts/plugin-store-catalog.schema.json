{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayleabot.local/contracts/plugin-store-catalog.schema.json",
  "title": "RayleaBot Plugin Store Catalog",
  "description": "Static plugin catalog metadata consumed by the RayleaBot server. Each entry describes its current published version and available platform artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "entries"],
  "properties": {
    "catalog_version": {
      "type": "string",
      "const": "2"
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://.+$"
    },
    "platform": {
      "type": "string",
      "enum": ["windows-x64", "linux-x64", "macos-arm64"]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/plugin_id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "url", "archive_sha256"],
      "properties": {
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "current_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "published_at", "min_core_version", "assets"],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "min_core_version": {
          "$ref": "#/$defs/semver"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "publisher",
        "repository_url",
        "license",
        "keywords",
        "recommended"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/plugin_id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "repository_url": {
          "$ref": "#/$defs/https_url"
        },
        "homepage": {
          "$ref": "#/$defs/https_url"
        },
        "icon_url": {
          "$ref": "#/$defs/https_url"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "keywords": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "recommended": {
          "type": "boolean"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "current_release": {
          "$ref": "#/$defs/current_release"
        }
      }
    }
  },
  "x-fixtures": [
    "fixtures/plugin-store-catalog/ok.official-catalog.json",
    "fixtures/plugin-store-catalog/edge.unpublished-plugin.json",
    "fixtures/plugin-store-catalog/invalid.insecure-asset-url.json"
  ]
}
